{
  "courseId": "PRIME",
  "lessonLabelTemplate": "PRIME · Lesson {lesson}",

  "brand": {
    "watermarkLogo": "nama-logo.png",
    "titleLogo": "prime-logo.png",
    "accentElement": "baseline"
  },

  "theme": {
    "colors": {
      "navy": "#1A1B3D",
      "deep": "#2D3060",
      "mid": "#3A3D70",
      "surface": "#FAF5F0",
      "accent": "#A02828",
      "accentLight": "#C44040",
      "cream": "#FFFFFF",
      "sand": "#F0E8E0",
      "panel": "rgba(255,255,255,0.92)",
      "panelEdge": "rgba(160,40,40,0.20)",
      "inkDim": "rgba(26,27,61,0.65)",
      "plumSafe": "#F5F0F8",
      "tealSafe": "#F0F5F5"
    },
    "headingFamily": "\"Inter\", \"Segoe UI\", Helvetica, Arial, sans-serif",
    "bodyFamily": "\"Inter\", \"Segoe UI\", Helvetica, Arial, sans-serif",
    "headingWeight": 700,
    "type": { "hero": 58, "title": 38, "cardTitle": 28, "body": 22, "label": 16 },
    "radius": { "card": 999, "chip": 999, "video": 24 }
  },

  "presenterGrammar": {
    "fullBleedTarget": 0.35,
    "splitWidthPct": 30,
    "minTurnSeconds": 2.0,
    "requireSideAlternation": true,
    "requireFullBleedBetweenSides": true,
    "softPushAmplitude": 0.05
  },

  "transitions": {
    "defaultTransition": "crossfade",
    "sectionTransition": "dip-to-brand"
  }
}
