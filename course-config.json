{
  "courseId": "ACT",
  "lessonLabelTemplate": "ACT · Lesson {lesson}",

  "brand": {
    "watermarkLogo": "nama-logo-white.png",
    "titleLogo": "nama-logo.png",
    "accentElement": "baseline"
  },

  "theme": {
    "colors": {
      "navy": "#1B1E4A",
      "deep": "#12142F",
      "mid": "#2B2F72",
      "surface": "#454C8A",
      "accent": "#CFAD3A",
      "accentLight": "#E4C862",
      "cream": "#FAF7EE",
      "sand": "#F2ECDD",
      "panel": "rgba(18,20,47,0.82)",
      "panelEdge": "rgba(228,200,98,0.22)",
      "inkDim": "rgba(242,236,221,0.72)",
      "plumSafe": "#241738",
      "tealSafe": "#14303C"
    },
    "headingFamily": "\"Arial Black\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "bodyFamily": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "headingWeight": 900,
    "type": { "hero": 62, "title": 40, "cardTitle": 30, "body": 23, "label": 17 },
    "radius": { "card": 22, "chip": 12, "video": 20 }
  },

  "presenterGrammar": {
    "fullBleedTarget": 0.45,
    "splitWidthPct": 40,
    "minTurnSeconds": 2.0,
    "requireSideAlternation": true,
    "requireFullBleedBetweenSides": true,
    "softPushAmplitude": 0.07
  },

  "transitions": {
    "defaultTransition": "clean-cut",
    "sectionTransition": "section-reveal"
  }
}
