{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nama.foundation/schemas/avatar-lesson.schema.json",
  "title": "ACT realistic-avatar lesson manifest",
  "type": "object",
  "required": ["schemaVersion", "lesson", "mode", "fps", "width", "height", "totalSeconds", "scenes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "lesson": {"type": "string", "pattern": "^lesson-[A-Za-z0-9_-]+$"},
    "mode": {"enum": ["avatar-scenes", "avatar-master"]},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "width": {"const": 1920},
    "height": {"const": 1080},
    "totalSeconds": {"type": "number", "exclusiveMinimum": 0},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "pureText", "performanceText", "durationSeconds", "avatar"],
        "properties": {
          "id": {"type": "string", "pattern": "^scene-[A-Za-z0-9_-]+$"},
          "pureText": {"type": "string", "minLength": 1, "maxLength": 800},
          "performanceText": {"type": "string", "minLength": 1},
          "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
          "avatar": {
            "type": "object",
            "required": ["src", "layout", "position"],
            "properties": {
              "src": {"type": "string"},
              "layout": {"enum": ["full", "corner", "hidden"]},
              "position": {"enum": ["left", "right"]}
            },
            "additionalProperties": false
          },
          "transitionOut": {
            "type": ["object", "null"],
            "properties": {
              "kind": {"enum": ["soft-push-left", "soft-push-right", "scale-through", "crossfade", "mask-wipe", "clean-cut", "section-reveal", "dip-to-brand"]},
              "scope": {"enum": ["presenter-card", "main-canvas", "full-frame", "coordinated"]},
              "durationFrames": {"type": "integer", "minimum": 1, "maximum": 30}
            },
            "required": ["kind", "scope", "durationFrames"],
            "additionalProperties": false
          }
        }
      }
    }
  }
}
